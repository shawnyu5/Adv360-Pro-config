#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"
      #ifndef VERSION_MACRO

        macro_ver: macro_ver {
            compatible = "zmk,behavior-macro";
            label = "macro_version";
            #binding-cells = <0>;
            bindings = <&kp RET>;
        };

        #endif

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        ios_layer_toggle: ios_layer_toggle {
            compatible = "zmk,behavior-macro-one-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <1>;
            bindings =
                <&macro_param_1to2>,
                <&macro_tap>,
                <&bt BT_SEL MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&to 2>;
        };

        default_layer_toggle: default_layer_toggle {
            compatible = "zmk,behavior-macro-one-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <1>;
            bindings =
                <&macro_param_1to2>,
                <&macro_tap>,
                <&bt BT_SEL MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&to 0>;
        };

        mac_layer_toggle: mac_layer_toggle {
            compatible = "zmk,behavior-macro-one-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <1>;
            bindings =
                <&macro_param_1to2>,
                <&macro_tap>,
                <&bt BT_SEL MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&to 1>;

            label = "MAC_LAYER_TOGGLE";
        };
    };

    combos {
        compatible = "zmk,combos";

        caps_word {
            bindings = <&caps_word>;
            key-positions = <46 59>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &tog 5                                                                       &mo 5      &kp N6  &kp N7          &kp N8        &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                                        &none      &kp Y   &kp U           &kp I         &kp O     &kp P     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LEFT_ALT      &kp RIGHT_CONTROL      &kp RIGHT_WIN  &kp RCTRL  &none      &kp H   &kp J           &kp K         &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                               &kp HOME               &kp PG_UP                            &kp N   &kp M           &kp COMMA     &kp DOT   &kp FSLH  &kp RSHFT
&mo 4      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp LEFT_CONTROL  &kp END                &kp PG_DN      &kp ENTER  &kp SPACE          &kp DOWN_ARROW  &kp UP_ARROW  &kp LBKT  &kp RBKT  &mo 4
            >;
        };

        Mac_layer {
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                              &mo 5      &kp N6  &kp N7          &kp N8        &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                               &none      &kp Y   &kp U           &kp I         &kp O     &kp P     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LEFT_ALT  &kp LEFT_CONTROL      &kp LGUI   &kp RCTRL  &none      &kp H   &kp J           &kp K         &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                           &kp HOME              &kp PG_UP                        &kp N   &kp M           &kp COMMA     &kp DOT   &kp FSLH  &kp RSHFT
&trans     &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp LEFT_GUI  &kp END               &kp PG_DN  &kp ENTER  &kp SPACE          &kp DOWN_ARROW  &kp UP_ARROW  &kp LBKT  &kp RBKT  &trans
            >;
        };

        ios_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                        &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                        &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp RALT  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans    &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        Gaming {
            bindings = <
&kp ESCAPE      &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &trans                                                             &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp TAB         &kp Q   &kp W   &kp E   &kp R   &kp T   &none                                                              &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp CAPSLOCK    &kp A   &kp S   &kp D   &kp F   &kp G   &none      &kp LEFT_ALT      &kp LEFT_CONTROL      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &trans  &trans  &trans  &trans  &trans                               &kp B                 &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans  &trans  &trans  &trans          &kp SPACE  &kp LEFT_CONTROL  &kp LEFT_CONTROL      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        fn {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 4                                      &mo 5   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            bindings = <
&none  &default_layer_toggle 0  &default_layer_toggle 1  &to 3          &ios_layer_toggle 3  &mac_layer_toggle 4  &none                                                  &trans                  &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4  &bt BT_CLR
&none  &none                    &none                    &none          &none                &none                &bootloader                                            &bootloader             &none          &out OUT_USB   &out OUT_BLE   &none          &none          &none
&none  &none                    &none                    &none          &none                &none                &none        &none  &none      &bt BT_CLR  &none       &rgb_ug RGB_MEFS_CMD 5  &none          &none          &none          &none          &none          &none
&none  &none                    &none                    &none          &macro_ver           &none                                    &none      &none                                           &none          &none          &none          &none          &none          &none
&none  &none                    &none                    &kp C_AC_BACK  &kp C_AC_FORWARD                          &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG                        &bl BL_INC     &bl BL_DEC     &none          &none          &none
            >;
        };
    };
};
